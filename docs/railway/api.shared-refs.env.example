# ---------------------------------------------------------------------------
# Railway service: api  — variant that REFERENCES project Shared Variables.
# Use this INSTEAD OF api.env.example if you put credentials in the shared
# panel (docs/railway/shared.env.example).
#
# Paste into Railway -> api -> Variables -> Raw Editor.
# Safe to commit: contains references, not secrets.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Service-specific: not shared, differs per service/environment ----------
FRONTEND_URL=https://legal.bigapp.ai
API_PUBLIC_URL=https://legal.bigapp.ai/api
TRUST_PROXY_HOPS=1
QUEUE_DRIVER=postgres
WORKERS_MODE=thread
# Do NOT set PORT — Railway injects it.
# Do NOT set REDIS_URL / ASYNC_* — they silently re-enable Redis.

# --- Pulled from project Shared Variables -----------------------------------
SUPABASE_URL=${{shared.SUPABASE_URL}}
SUPABASE_PUBLISHABLE_KEY=${{shared.SUPABASE_PUBLISHABLE_KEY}}
SUPABASE_SECRET_KEY=${{shared.SUPABASE_SECRET_KEY}}
DOWNLOAD_SIGNING_SECRET=${{shared.DOWNLOAD_SIGNING_SECRET}}
USER_API_KEYS_ENCRYPTION_SECRET=${{shared.USER_API_KEYS_ENCRYPTION_SECRET}}
AUTH_HANDOFF_ENCRYPTION_SECRET=${{shared.AUTH_HANDOFF_ENCRYPTION_SECRET}}
R2_ENDPOINT_URL=${{shared.R2_ENDPOINT_URL}}
R2_ACCESS_KEY_ID=${{shared.R2_ACCESS_KEY_ID}}
R2_SECRET_ACCESS_KEY=${{shared.R2_SECRET_ACCESS_KEY}}
R2_BUCKET_NAME=${{shared.R2_BUCKET_NAME}}
ANTHROPIC_API_KEY=${{shared.ANTHROPIC_API_KEY}}

# --- Branding. Optional; defaults are already the BIG brand. ----------------
PRODUCT_NAME=BIG Agreements
SUPPORT_EMAIL=support@bigapp.work
PUBLIC_APP_URL=https://legal.bigapp.ai
PRIMARY_BRAND_URL=https://bigapp.work
LEGAL_FOOTER=BIG R/D
OPEN_SOURCE_NOTICE_URL=https://github.com/BIG-R-D/BIGAgreements
