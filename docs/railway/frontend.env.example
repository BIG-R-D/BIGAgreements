# ---------------------------------------------------------------------------
# Railway service: frontend
# Only ONE runtime variable. Everything else is build-time.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Server-side proxy target for /api/* (frontend/src/app/api/[...path]/route.ts).
# Keep the api service PRIVATE — the browser never talks to it directly, so it
# needs no public domain. If Railway private networking (IPv6) does not resolve
# on first deploy, give api a public domain and use that URL here instead.
API_BASE_URL=http://api.railway.internal:3001

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* are inlined by `next build` and are NOT read at runtime.
# Setting them here after a deploy does nothing — they need a REBUILD.
# All optional; unset means the BIG defaults. Uncomment only to override.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PRODUCT_NAME=BIG Agreements
# NEXT_PUBLIC_SUPPORT_EMAIL=support@bigapp.work
# NEXT_PUBLIC_PUBLIC_APP_URL=https://legal.bigapp.ai
# NEXT_PUBLIC_PRIMARY_BRAND_URL=https://bigapp.work
# NEXT_PUBLIC_TERMS_URL=https://bigapp.work/terms
# NEXT_PUBLIC_PRIVACY_URL=https://bigapp.work/privacy
# NEXT_PUBLIC_OPEN_SOURCE_NOTICE_URL=https://github.com/BIG-R-D/BIGAgreements
