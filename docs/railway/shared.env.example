# ---------------------------------------------------------------------------
# Railway PROJECT-level Shared Variables  (Settings -> Shared Variables)
# Paste into the shared panel's Raw Editor for the `production` environment.
#
# These do NOT apply to services automatically. Each service must reference
# them — see docs/railway/api.env.example, which uses ${{shared.NAME}}.
#
# What belongs here: credentials and infrastructure endpoints that more than
# one service needs (api today; a standalone worker in Phase 6). What does NOT:
# per-service config such as URLs, WORKERS_MODE or API_BASE_URL.
#
# Safe to commit: placeholders only.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=<PASTE https://your-ref.supabase.co>
SUPABASE_PUBLISHABLE_KEY=<PASTE Supabase anon/publishable key>
# service_role key — bypasses ALL row level security.
SUPABASE_SECRET_KEY=<PASTE Supabase service_role key>

# --- Secrets. Three DIFFERENT values: openssl rand -hex 32 ------------------
DOWNLOAD_SIGNING_SECRET=<PASTE 64 hex chars>
USER_API_KEYS_ENCRYPTION_SECRET=<PASTE 64 hex chars>
AUTH_HANDOFF_ENCRYPTION_SECRET=<PASTE 64 hex chars>

# --- Private object storage -------------------------------------------------
R2_ENDPOINT_URL=<PASTE https://<account-id>.r2.cloudflarestorage.com>
R2_ACCESS_KEY_ID=<PASTE R2 access key id>
R2_SECRET_ACCESS_KEY=<PASTE R2 secret access key>
R2_BUCKET_NAME=big-agreements

# --- AI provider ------------------------------------------------------------
ANTHROPIC_API_KEY=<PASTE or omit>
