# BuildKit per-Dockerfile ignore (context is the repo root — see Dockerfile).
# Keep the context lean: only frontend sources + backend/src type sources + word-addin/src type sources.
**/node_modules
**/.next
**/.open-next
**/out
**/dist
**/build
.git
backend/dist
backend/supabase
# word-addin/src is type-imported by frontend/src/wordAddin/*.test.ts,
# which `next build` type-checks. Keep those sources, drop everything else.
word-addin
!word-addin/src
!word-addin/src/**
desktop
docs
**/.env
**/.env.*
**/*.log
