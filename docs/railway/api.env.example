# ---------------------------------------------------------------------------
# Railway service: api  (backend)
# Paste into Railway → your service → Variables → Raw Editor, then fill the
# <PASTE ...> values. Safe to commit: contains no secrets.
# Reference: docs/ENVIRONMENT_VARIABLES.md
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- URLs. Must be https in production or the service refuses to boot. -------
FRONTEND_URL=https://legal.bigapp.ai
API_PUBLIC_URL=https://legal.bigapp.ai/api

# Railway terminates TLS at one proxy hop. Wrong value = rate limiting keys on
# the proxy IP instead of the client.
TRUST_PROXY_HOPS=1

# Do NOT set PORT — Railway injects it and the app reads process.env.PORT.

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=<PASTE https://your-ref.supabase.co>
SUPABASE_PUBLISHABLE_KEY=<PASTE Supabase anon/publishable key>
# service_role key — bypasses ALL row level security. Treat as the master
# credential for the whole database.
SUPABASE_SECRET_KEY=<PASTE Supabase service_role key>

# --- Secrets. Three DIFFERENT values: openssl rand -hex 32 -------------------
DOWNLOAD_SIGNING_SECRET=<PASTE 64 hex chars>
USER_API_KEYS_ENCRYPTION_SECRET=<PASTE 64 hex chars>
# >= 32 chars. Required by the WordPress session bridge (Phase 4).
AUTH_HANDOFF_ENCRYPTION_SECRET=<PASTE 64 hex chars>

# --- Private object storage (Cloudflare R2 or any S3-compatible) -------------
# Never Railway's ephemeral disk — contracts must be durable.
R2_ENDPOINT_URL=<PASTE https://<account-id>.r2.cloudflarestorage.com>
R2_ACCESS_KEY_ID=<PASTE R2 access key id>
R2_SECRET_ACCESS_KEY=<PASTE R2 secret access key>
R2_BUCKET_NAME=big-agreements

# --- AI provider. At least one required. -------------------------------------
ANTHROPIC_API_KEY=<PASTE or delete this line>
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Queue and workers -------------------------------------------------------
# postgres = no Redis service at all.
# WARNING: setting REDIS_URL, ASYNC_DOCUMENT_CONVERSION=true or
# ASYNC_TABULAR_EXTRACTION=true silently flips the driver back to Redis
# (see backend/src/lib/dbq/driver.ts). Leave all three unset.
QUEUE_DRIVER=postgres
WORKERS_MODE=thread

# --- Branding. All optional; defaults are already the BIG brand. -------------
PRODUCT_NAME=BIG Agreements
SUPPORT_EMAIL=support@bigapp.work
PUBLIC_APP_URL=https://legal.bigapp.ai
PRIMARY_BRAND_URL=https://bigapp.work
LEGAL_FOOTER=BIG R/D
# AGPL-3.0 section 13 source offer — see docs/OPEN_SOURCE_COMPLIANCE.md
OPEN_SOURCE_NOTICE_URL=https://github.com/BIG-R-D/BIGAgreements
